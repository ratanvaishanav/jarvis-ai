

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JARVIS AI</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #020817;
  color: #00d9ff;
  font-family: Arial, sans-serif;
  text-align: center;
}

h1 {
  margin-top: 35px;
  letter-spacing: 5px;
  text-shadow: 0 0 15px #00d9ff;
}

.status {
  color: #9bdfff;
  margin-top: 10px;
}

.core {
  width: 190px;
  height: 190px;
  border: 3px solid #00d9ff;
  border-radius: 50%;
  margin: 55px auto 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 25px #00aaff,
              inset 0 0 25px #0077ff;
  animation: glow 2s infinite alternate;
}

.core span {
  font-size: 48px;
}

@keyframes glow {
  from { box-shadow: 0 0 10px #00aaff; }
  to { box-shadow: 0 0 35px #00d9ff; }
}

button {
  background: #003b64;
  color: white;
  border: 1px solid #00d9ff;
  padding: 14px 22px;
  border-radius: 30px;
  font-size: 16px;
  margin: 8px;
}

input {
  width: 85%;
  padding: 14px;
  border-radius: 20px;
  border: 1px solid #00d9ff;
  background: #07182b;
  color: white;
  margin-top: 20px;
}

#chat {
  margin: 25px auto;
  width: 90%;
  max-width: 450px;
  min-height: 90px;
  text-align: left;
  color: white;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

</style>
</head>

<body>

<h1>J.A.R.V.I.S</h1>
<div class="status" id="status">
  SYSTEM ONLINE
</div>

<div class="core">
  <span>◉</span>
</div>

<button onclick="startListening()">🎙️ Speak</button>
<button onclick="stopSpeaking()">🔇 Stop Voice</button>

<br>

<input id="message"
placeholder="Talk to JARVIS..." />

<button onclick="sendMessage()">Send</button>

<div id="chat">
  <b>JARVIS:</b> Hello Sir! I am ready.
</div>

<script>

const statusText = document.getElementById("status");
const chat = document.getElementById("chat");

function showMessage(who, message) {
  const line = document.createElement("p");
  const label = document.createElement("b");
  label.textContent = who + ": ";
  line.appendChild(label);
  line.appendChild(document.createTextNode(message));
  chat.appendChild(line);
}

function speak(text) {
  speechSynthesis.cancel();

  const speech = new SpeechSynthesisUtterance(text);
  speech.lang = /[\u0900-\u097F]/.test(text)
    ? "hi-IN" : "en-IN";

  const voices = speechSynthesis.getVoices();

  const femaleVoice = voices.find(v =>
    /female|woman|zira|samantha|heera/i.test(v.name)
  );

  if (femaleVoice) {
    speech.voice = femaleVoice;
  }

  speechSynthesis.speak(speech);
}

function sendMessage() {
  const input = document.getElementById("message");
  const text = input.value.trim();

  if (!text) return;

  showMessage("YOU", text);

  let reply = "I am ready to help you, Sir!";

  const lower = text.toLowerCase();

  if (lower.includes("hello") ||
      lower.includes("नमस्ते")) {
    reply = "Hello Sir! कैसे मदद कर सकती हूँ?";
  }
  else if (lower.includes("your name") ||
           lower.includes("नाम")) {
    reply = "मेरा नाम JARVIS है।";
  }
  else if (lower.includes("time") ||
           lower.includes("समय")) {
    reply = "अभी समय है " +
      new Date().toLocaleTimeString("hi-IN");
  }
  else if (lower.includes("date") ||
           lower.includes("तारीख")) {
    reply = "आज की तारीख है " +
      new Date().toLocaleDateString("hi-IN");
  }
  else if (lower.includes("how are you") ||
           lower.includes("कैसी हो")) {
    reply = "मैं बिल्कुल तैयार हूँ Sir!";
  }

  showMessage("JARVIS", reply);
  speak(reply);

  input.value = "";
}

function startListening() {
  const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    statusText.textContent =
      "Speech recognition not supported";
    return;
  }

  const recognition = new SpeechRecognition();

  recognition.lang = "hi-IN";
  recognition.interimResults = false;

  recognition.onstart = () => {
    statusText.textContent = "LISTENING...";
  };

  recognition.onresult = (event) => {
    document.getElementById("message").value =
      event.results[0][0].transcript;

    statusText.textContent = "VOICE RECEIVED";
    sendMessage();
  };

  recognition.onerror = () => {
    statusText.textContent = "VOICE ERROR";
  };

  recognition.onend = () => {
    if (statusText.textContent === "LISTENING...") {
      statusText.textContent = "SYSTEM ONLINE";
    }
  };

  recognition.start();
}

function stopSpeaking() {
  speechSynthesis.cancel();
  statusText.textContent = "SYSTEM ONLINE";
}

</script>

</body>
</html>
